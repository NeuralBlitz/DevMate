modules = ["nodejs-20", "python-3.11"]
[agent]
expertMode = true

[objectStorage]
defaultBucketID = "replit-objstore-c6876802-4522-43f2-b9ca-1c7d2e209c5a"

[nix]
packages = ["alacritty", "fish", "h", "haskellPackages.pandoc", "kitty", "mkdocs", "zsh", "zz", "rustup"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd web && npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
